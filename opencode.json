{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["opencode-go"],
  "model": "opencode-go/gpt-5.6-luna",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "leader",
  "subagent_depth": 1,
  "instructions": ["AGENTS.md"],
  "permission": {
    "read": {
      "*": "allow",
      "**/.env*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/id_rsa*": "deny",
      "**/credentials*": "deny",
      "**/secrets*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "deny",
    "bash": {
      "*": "deny",
      "git status": "allow",
      "git status --short": "allow",
      "git diff": "allow",
      "git diff --stat": "allow",
      "git diff --name-only": "allow",
      "git log": "allow",
      "git log --oneline -10": "allow"
    },
    "task": "deny",
    "todowrite": "deny",
    "question": "deny",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "doom_loop": "deny",
    "skill": "deny",
    "lsp": "allow"
  },
  "agent": {
    "build": {
      "model": "opencode-go/gpt-5.6-luna"
    },
    "plan": {
      "model": "opencode-go/gpt-5.6-luna"
    },
    "general": {
      "disable": true,
      "model": "opencode-go/deepseek-v4-flash"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    }
  }
}
