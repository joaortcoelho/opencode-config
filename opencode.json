{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["opencode-go"],
  "model": "opencode-go/gpt-5.6-luna",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "leader",
  "subagent_depth": 1,
  "instructions": ["AGENTS.md"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "deny",
    "bash": {
      "*": "deny",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow"
    },
    "websearch": "deny",
    "doom_loop": "deny",
    "skill": "deny",
    "lsp": "allow"
  },
  "agent": {
    "build": {
      "model": "opencode-go/gpt-5.6-luna"
    },
    "plan": {
      "model": "opencode-go/gpt-5.6-luna"
    },
    "general": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    }
  }
}
